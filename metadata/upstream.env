# mihomo 版本锁定 v1.19.31，不再变动：切勿跟随最新版升级，
# 升级需人工评估行为兼容性后在本文件同时改版本、四个架构 SHA256 与资产名。
# 资产为单文件 gzip（非 tar），安装时 gzip -dc 解出后赋予可执行权限。
MIHOMO_VERSION="v1.19.31"
MIHOMO_VERSION_PLAIN="1.19.31"

declare -A MIHOMO_SHA256=(
  [amd64]="d5e74bbddbdfff49a1aef7775bf5911da59f0d7196ed509a0ac914b3653dd5f1"
  [arm64]="9e0f11afbf38426b8bd88fdc594678f8161c57eccb4e1b77acb12b493904f1d4"
  [armv7]="a61115819d9ebd568788b0f1bddfa6c9c03458071abdbda80f79291cac0276e1"
  [armv6]="a89e15d8f425c809a60376821218f3ea97b2998c46ba87c80d1ede832d28fd88"
)

declare -A MIHOMO_ASSET=(
  [amd64]="mihomo-linux-amd64-v1.19.31.gz"
  [arm64]="mihomo-linux-arm64-v1.19.31.gz"
  [armv7]="mihomo-linux-armv7-v1.19.31.gz"
  [armv6]="mihomo-linux-armv6-v1.19.31.gz"
)

# 下载源依次尝试（首个成功即停，SHA256 校验不因换源放松）：
# 1) 官方 GitHub Release；2) 本仓库同名 Release 镜像。
# （镜像与官方源同属 github.com 域——价值是官方资产被删除/限流/区域异常时的备份副本，
# 并非规避 GFW；切勿据此宣传镜像更易访问。）
MIHOMO_MIRROR_BASE="https://github.com/${REPO_OWNER:-plitoy}/${REPO_NAME:-Mihomo-Manager}/releases/download/upgrade-mirror"

# cloudflared 默认跟随官方最新版：安装时通过 GitHub API 获取最新版本
# 与官方发布的 digest（SHA256）校验，不锁定版本。
CLOUDFLARED_LATEST="true"

# 供应链安全（强校验，失败即止）：
#   - 首选 GitHub API（版本 + 官方 digest 完整 SHA256 校验）；
#   - API 不可用且解析版本恰好等于固定回退版本时，用固定 digest 完整校验；
#   - 仍拿不到可信 digest 时默认 fail-closed 拒绝安装，绝不静默跳过完整性校验。
# 仅当用户显式设置 CLOUDFLARED_ALLOW_RUNTIME_VERIFY=1 时才允许降级为
# "下载后实测 cloudflared version 与期望一致 + 可执行校验"（此强度不能证明
# 二进制内容来自官方，非默认）。建议不要把该变量写进生产环境。
CLOUDFLARED_FALLBACK_VERSION="2026.8.3"

declare -A CLOUDFLARED_SHA256=(
  [amd64]="f29324fe934d1e100617484c78deef803c4dc2cd351d645bbde42e96b4fccc5e"
  [arm64]="4bcfd35521a7cbc545ebfd5d57334a71ee180e2a64874981f374c81472118391"
  [armv7]="d8bd9d00c15398ef4c6e6bc1a0486b6f1eb8c0dfd93e7479e07a121aa4e3dd57"
  [armv6]="7a7cac4ad4561ff55797eaf27aae1a0be37498c85502715bc87e3bad919d928c"
)

declare -A CLOUDFLARED_ASSET=(
  [amd64]="cloudflared-linux-amd64"
  [arm64]="cloudflared-linux-arm64"
  [armv7]="cloudflared-linux-armhf"
  [armv6]="cloudflared-linux-arm"
)

# cloudflared 下载源依次尝试（与 mihomo 同一说明：镜像价值是官方资产异常时的备份副本，
# 不构成规避 GFW 的手段）
CLOUDFLARED_MIRROR_BASE="https://github.com/${REPO_OWNER:-plitoy}/${REPO_NAME:-Mihomo-Manager}/releases/download/upgrade-mirror"

# Ookla 官方 speedtest CLI：版本锁定（M1，此前该变量从未定义导致下载 URL 缺版本段而失败）。
# 非关键路径（仅供 net_tune 调优参考），定义 OOKLA_SHA256_<arch> 后下载即强校验，
# 不匹配则弃用并回退缺省调优参数，绝不静默跳过；未定义则回退仅"可执行"校验。
OOKLA_SPEEDTEST_VERSION="1.2.0"

declare -A OOKLA_SHA256=(
  [x86_64]="5690596c54ff9bed63fa3732f818a05dbc2db19ad36ed68f21ca5f64d5cfeeb7"
  [aarch64]="3953d231da3783e2bf8904b6dd72767c5c6e533e163d3742fd0437affa431bd3"
)

# MTProxy 依赖 mtg-go：版本/哈希锁定在 mtp.sh 内置 MTP_SHA256 表（H3）。
# 上游为 dev 构建、发布即重建，需要覆盖时用环境变量 MTP_SHA256_amd64/MTP_SHA256_arm64
# 显式指定；确实无法核验时可用 MTP_ALLOW_RUNTIME_VERIFY=1 降级（仅可执行校验，不推荐）。

# 低内存守卫：可用内存低于该值（MB）时收紧配置（cloudflared 强制 http2、提示少开协议）
MM_LOW_MEM_MB="200"
